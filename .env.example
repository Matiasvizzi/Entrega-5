# Proveedor del LLM: gemini (por defecto) | openai | anthropic
LLM_PROVIDER=gemini

# Completá la key del proveedor elegido
GOOGLE_API_KEY=tu_api_key_aqui        # gratis en https://aistudio.google.com/apikey
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Opcional: modelo a usar
# GEMINI_MODEL=gemini-flash-lite-latest
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
